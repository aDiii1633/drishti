NODE_ENV=development
PORT=3000

# Generate unique values for every deployment. Never use these placeholders in production.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
QR_SIGNING_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Database and runtime mode.
DATABASE_URL=file:local-data/drishti.db
DEMO_DATABASE_URL=file:local-data/drishti-demo.db
APP_MODE=demo
DEMO_MODE=true
DRISHTI_DEMO_PASSWORD=YOUR_LOCAL_DEMO_PASSWORD
OFFICIAL_EMAIL_DOMAIN=

# Gemini evaluation. These are server-only settings.
GEMINI_API_KEY=
GEMINI_GRADING_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ScanGate gateway. These are server-only settings.
SCANGATE_ADAPTER=
SCANGATE_BASE_URL=
SCANGATE_REVIEWER_TOKEN=
SCANGATE_STATION_CODE=

# Local ScanGate USB device agent. Keep this loopback-only.
SCANGATE_USE_REAL_HARDWARE=false
SCANGATE_USB_AGENT_URL=http://127.0.0.1:57931
SCANGATE_USB_EXPECTED_DEVICE_ID=
SCANGATE_USB_EXPECTED_VID_PID=
SCANGATE_USB_PORT=
SCANGATE_USB_BAUD_RATE=921600
SCANGATE_USB_INGEST_URL=http://127.0.0.1:8000/api/v1/captures/usb
SCANGATE_USB_INGEST_TOKEN=REPLACE_WITH_A_LONG_RANDOM_LOCAL_TOKEN

# Optional hosted integrations.
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Public origin used to build absolute URLs for stored files (server/storage.ts).
# Leave blank for local development; it falls back to http://127.0.0.1:<PORT>.
# Set this in any deployment placed behind a proxy or public hostname.
PUBLIC_APP_URL=

# Optional: run the in-app assistant on a different model from the grader.
# When unset, the assistant falls back to GEMINI_GRADING_MODEL.
GEMINI_MODEL=

# Legacy ScaleMax-compatible grading gateway. Superseded by the Gemini path
# above and left unset on new deployments; see DRISHTI_AI_PIPELINE.md.
SCALEMAX_BASE_URL=
SCALEMAX_API_KEY=
SCALEMAX_MODEL=
SCALEMAX_DOCUMENT_FILE_QA=false
