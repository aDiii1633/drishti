{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "VITE_DEMO_ACCESS_MODE=true vite build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-YOUR-API-HOST/api/:path*"
    },
    {
      "source": "/manus-storage/:path*",
      "destination": "https://REPLACE-WITH-YOUR-API-HOST/manus-storage/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
